# Copy to `.env` (ignored by git) and fill in the FTP details from the hosting panel.
FTP_HOST=ftp.lasorti.ro
FTP_USER=
FTP_PASSWORD=
# The site folder on the server (usually /public_html/ or / on cPanel hosting).
# Check it with `npm run deploy:check` before the first deploy.
FTP_ROOT=/public_html/
# FTPS (encrypted connection). If you get a certificate error, set FTP_HOST to the server hostname
# from the hosting panel. Use false only as a last resort.
FTP_SECURE=true
# FTP port, only if it is not 21.
# FTP_PORT=21
