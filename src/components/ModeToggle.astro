---
// Light/dark button. The icon shows the mode you would switch to.
---

<button
  class="mode-toggle"
  type="button"
  aria-label="Schimbă tema (luminoasă / întunecată)"
  title="Temă luminoasă / întunecată"
>
  <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" fill="currentColor" />
    <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" />
    </g>
  </svg>
  <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1z" />
  </svg>
</button>
<script>
  import { toggleMode } from '../scripts/mode';
  document.querySelectorAll('.mode-toggle').forEach((b) => b.addEventListener('click', toggleMode));
</script>
